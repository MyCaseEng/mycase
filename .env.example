# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# Public values (safe in the browser): Supabase project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never prefixed with NEXT_PUBLIC_, never pasted in chat). Added in later steps.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
